#!/usr/bin/env python3
"""
Ambrosia Wi-Fi setup portal.

Runs at boot. Waits briefly for NetworkManager to auto-connect to a known
Wi-Fi. If none is found, takes wlan0 out of NM management, brings up hostapd
(AP) and dnsmasq (DHCP) directly, and serves a Flask captive portal on port 80
where the user types an SSID + password. On successful connection we tear down
hostapd/dnsmasq, hand wlan0 back to NM, and exit; systemd treats clean exit
as success and won't restart us.

Uses hostapd directly because NetworkManager's built-in AP mode relies on
wpa_supplicant, which doesn't work reliably on the Orange Pi Zero 2W's Wi-Fi
driver (wpa_supplicant times out after 30s trying to start AP mode).
"""

import os
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

from flask import Flask, redirect, render_template_string, request

WLAN = "wlan0"
AP_IP = "10.42.1.1"
AP_SUBNET = "10.42.1.0/24"
DHCP_START = "10.42.1.100"
DHCP_END = "10.42.1.150"
HOSTAPD_CONF = Path("/run/ambrosia-wifi-portal/hostapd.conf")
DNSMASQ_CONF = Path("/run/ambrosia-wifi-portal/dnsmasq.conf")
DNSMASQ_LEASES = Path("/run/ambrosia-wifi-portal/dnsmasq.leases")
BOOT_WAIT_SECONDS = 30
WIFI_RECOVERY_MARKER = Path("/run/ambrosia-wifi-recovery-attempted")

app = Flask(__name__)
hostapd_process = None
dnsmasq_process = None
# Populated by main() before start_ap(). AP mode disables scanning, so we have
# to capture the airwaves while wlan0 is still managed by NM.
scanned_ssids = []
connection_lock = threading.Lock()


def run_command(command_arguments, timeout_seconds=None):
    return subprocess.run(
        command_arguments,
        capture_output=True,
        text=True,
        timeout=timeout_seconds,
        check=False,
    )


def get_hostname():
    return run_command(["hostname"]).stdout.strip() or "ambrosia"


def wifi_is_real():
    """True if wlan0 is currently on a non-AP Wi-Fi managed by NM."""
    device_status_process = run_command(
        ["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device"]
    )
    for device_status_line in device_status_process.stdout.splitlines():
        device_fields = device_status_line.split(":")
        if (
            len(device_fields) >= 3
            and device_fields[0] == WLAN
            and device_fields[1] == "wifi"
            and device_fields[2] == "connected"
        ):
            return True
    return False


def is_orange_pi():
    """Return true for boards affected by the unisoc_wifi TCP stall."""
    identity = Path("/etc/ambrosia/board-identity")
    try:
        return "BOARD_SHORT_NAME=opi" in identity.read_text()
    except OSError:
        return False


def recover_orange_pi_wifi_once():
    """Bounce an associated OPi link once per boot.

    The unisoc_wifi driver can report an associated link with a DHCP address
    while TCP traffic remains stuck. Reconnecting through NetworkManager is
    the reliable recovery and is deliberately limited to one attempt per boot.
    """
    if not is_orange_pi() or WIFI_RECOVERY_MARKER.exists() or not wifi_is_real():
        return

    WIFI_RECOVERY_MARKER.touch()
    print(
        "Orange Pi Wi-Fi is associated; cycling wlan0 to prevent a stalled TCP link.",
        flush=True,
    )
    try:
        run_command(["nmcli", "device", "disconnect", WLAN], timeout_seconds=15)
        time.sleep(2)
        reconnect_process = run_command(
            ["nmcli", "device", "connect", WLAN], timeout_seconds=45
        )
        if reconnect_process.returncode != 0:
            print(
                f"Wi-Fi recovery failed: {reconnect_process.stderr.strip()}",
                flush=True,
            )
        time.sleep(3)
    except subprocess.TimeoutExpired:
        print("Wi-Fi recovery timed out; continuing to the setup portal.", flush=True)


def uplink_is_real():
    """True if a non-portal uplink is already available.

    The setup AP should stay down if Ethernet already has connectivity.
    """
    device_status_process = run_command(
        ["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device"]
    )
    for device_status_line in device_status_process.stdout.splitlines():
        device_fields = device_status_line.split(":")
        if len(device_fields) >= 3 and device_fields[2] == "connected":
            if device_fields[1] == "ethernet":
                return True
            if device_fields[1] == "wifi" and device_fields[0] != WLAN:
                return True
    return False


def scan_ssids():
    """Return a list of nearby SSIDs sorted by signal strength (strongest first).

    Must run while wlan0 is still managed by NM — once we flip to AP mode the
    radio can't scan. Hidden SSIDs (empty name) and duplicates are dropped."""
    run_command(
        ["nmcli", "device", "wifi", "rescan", "ifname", WLAN],
        timeout_seconds=15,
    )
    time.sleep(3)
    scan_process = run_command(
        ["nmcli", "-t", "-f", "SSID,SIGNAL", "device", "wifi", "list", "ifname", WLAN]
    )
    networks_by_signal = {}
    for scan_line in scan_process.stdout.splitlines():
        # nmcli -t escapes ":" inside SSIDs as "\:" — rsplit on the last
        # unescaped colon to split SSID from SIGNAL.
        if not scan_line:
            continue
        separator_index = scan_line.rfind(":")
        if separator_index < 0:
            continue
        network_name = scan_line[:separator_index].replace("\\:", ":").strip()
        try:
            signal_strength = int(scan_line[separator_index + 1 :])
        except ValueError:
            signal_strength = 0
        if not network_name:
            continue
        if (
            network_name not in networks_by_signal
            or signal_strength > networks_by_signal[network_name]
        ):
            networks_by_signal[network_name] = signal_strength
    return [
        network_name
        for network_name, _signal_strength in sorted(
            networks_by_signal.items(),
            key=lambda network_and_signal: -network_and_signal[1],
        )
    ]


def write_confs():
    HOSTAPD_CONF.parent.mkdir(parents=True, exist_ok=True)
    ap_ssid = f"{get_hostname()}-setup"
    HOSTAPD_CONF.write_text(
        f"interface={WLAN}\n"
        f"driver=nl80211\n"
        f"ssid={ap_ssid}\n"
        "hw_mode=g\n"
        "channel=6\n"
        "auth_algs=1\n"
        "wmm_enabled=0\n"
        "ignore_broadcast_ssid=0\n"
    )
    DNSMASQ_CONF.write_text(
        f"interface={WLAN}\n"
        f"bind-interfaces\n"
        f"dhcp-range={DHCP_START},{DHCP_END},255.255.255.0,12h\n"
        f"dhcp-option=3,{AP_IP}\n"  # gateway
        f"dhcp-option=6,{AP_IP}\n"  # DNS
        # Redirect all DNS lookups to the portal IP for captive-portal detection
        f"address=/#/{AP_IP}\n"
        f"dhcp-authoritative\n"
        f"dhcp-leasefile={DNSMASQ_LEASES}\n"
        f"log-queries\n"
        f"log-dhcp\n"
    )


def start_ap():
    """Take wlan0 out of NM, kill wpa_supplicant, reset iftype, start hostapd + dnsmasq.

    Order matters: NM's supplicant keeps a handle on wlan0 that prevents hostapd
    from setting beacon parameters. We unmanage first, then stop the supplicant,
    then explicitly set the interface to AP type on a down interface. Without
    this exact sequence the driver returns -EIO and hostapd fails."""
    global hostapd_process, dnsmasq_process

    # Caddy (and anything else binding port 80) has to step aside for the
    # captive portal. We'll start Caddy back up in stop_ap().
    run_command(["systemctl", "stop", "caddy"])
    run_command(["systemctl", "stop", "dnsmasq"])
    run_command(["systemctl", "stop", "hostapd"])
    run_command(["nmcli", "device", "set", WLAN, "managed", "no"])
    run_command(["systemctl", "stop", "wpa_supplicant"])
    run_command(["ip", "link", "set", WLAN, "down"])
    run_command(["iw", WLAN, "set", "type", "__ap"])
    run_command(["ip", "link", "set", WLAN, "up"])
    run_command(["ip", "addr", "flush", "dev", WLAN])
    run_command(["ip", "addr", "add", f"{AP_IP}/24", "dev", WLAN])

    write_confs()

    hostapd_process = subprocess.Popen(
        ["hostapd", str(HOSTAPD_CONF)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )
    # Give hostapd ~2s to establish; then start dnsmasq
    time.sleep(2)
    if hostapd_process.poll() is not None:
        print("hostapd exited immediately — giving up.", flush=True)
        return False

    dnsmasq_process = subprocess.Popen(
        ["dnsmasq", "--conf-file=" + str(DNSMASQ_CONF), "--no-daemon"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )
    time.sleep(1)
    if dnsmasq_process.poll() is not None:
        print("dnsmasq exited immediately — giving up.", flush=True)
        return False
    return True


def stop_ap():
    """Shut down hostapd + dnsmasq and hand wlan0 back to NM.

    Does NOT restart Caddy — callers must do that only when we're fully done
    with port 80, i.e. after Flask shuts down. If we restart Caddy here while
    Flask is still bound to :80, Caddy fails with EADDRINUSE."""
    global hostapd_process, dnsmasq_process
    for service_process in (dnsmasq_process, hostapd_process):
        if service_process and service_process.poll() is None:
            service_process.terminate()
            try:
                service_process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                service_process.kill()
    dnsmasq_process = None
    hostapd_process = None
    run_command(["ip", "addr", "flush", "dev", WLAN])
    run_command(["ip", "link", "set", WLAN, "down"])
    run_command(["iw", WLAN, "set", "type", "managed"])
    run_command(["ip", "link", "set", WLAN, "up"])
    run_command(["systemctl", "start", "wpa_supplicant"])
    run_command(["nmcli", "device", "set", WLAN, "managed", "yes"])
    time.sleep(2)


def restart_caddy():
    """Restore Caddy after Flask has fully released port 80."""
    run_command(["systemctl", "start", "caddy"])


