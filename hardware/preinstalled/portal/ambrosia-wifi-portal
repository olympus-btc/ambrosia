    return redirect("/", code=302)


def shutdown_on_signal(signum, frame):
    stop_ap()
    os._exit(0)


def main():
    signal.signal(signal.SIGTERM, shutdown_on_signal)
    signal.signal(signal.SIGINT, shutdown_on_signal)

    run_command(["nmcli", "device", "set", WLAN, "managed", "yes"])
    run_command(["nmcli", "radio", "wifi", "on"])

    for _ in range(BOOT_WAIT_SECONDS):
        if wifi_is_real():
            recover_orange_pi_wifi_once()
            if wifi_is_real():
                print("Network uplink already connected, exiting.", flush=True)
                return
        if uplink_is_real():
            print("Network uplink already connected, exiting.", flush=True)
            return
        time.sleep(1)

    print("No known Wi-Fi — scanning for nearby SSIDs before AP mode.", flush=True)
    global scanned_ssids
    try:
        scanned_ssids = scan_ssids()
        print(f"Found {len(scanned_ssids)} SSIDs: {scanned_ssids}", flush=True)
    except Exception as scan_error:  # noqa: BLE001 -- scanning must not block setup
        print(f"Scan failed (continuing without list): {scan_error}", flush=True)
        scanned_ssids = []

    print("Bringing up setup AP (hostapd + dnsmasq).", flush=True)
    if not start_ap():
        sys.exit(1)
    threading.Thread(target=_monitor_connection, daemon=True).start()
    try:
        app.run(host="0.0.0.0", port=80, debug=False, use_reloader=False)
    finally:
        stop_ap()


if __name__ == "__main__":
    main()
