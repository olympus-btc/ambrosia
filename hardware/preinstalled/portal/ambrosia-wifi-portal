@app.after_request
def prevent_portal_caching(portal_response):
    # Confirmation forms contain Wi-Fi credentials.
    portal_response.headers["Cache-Control"] = "no-store"
    portal_response.headers["Referrer-Policy"] = "no-referrer"
    return portal_response


def _monitor_connection():
    while True:
        time.sleep(15)
        if not connection_lock.acquire(blocking=False):
            continue
        try:
            if wifi_is_real() or uplink_is_real():
                stop_ap()
                os._exit(0)
        finally:
            connection_lock.release()


def _connect_to_wifi(network_name, wifi_password):
    """Switch the radio once; restore the portal when association fails.

    The caller holds connection_lock so requests and the uplink monitor
    cannot change the interface while NetworkManager is connecting.
    """
    try:
        # Give the HTTP response time to reach the phone before dropping AP.
        time.sleep(1)
        try:
            stop_ap()
            connection_process = run_command(
                [
                    "nmcli",
                    "device",
                    "wifi",
                    "connect",
                    network_name,
                    "password",
                    wifi_password,
                    "ifname",
                    WLAN,
                ],
                timeout_seconds=60,
            )
            if connection_process.returncode == 0:
                os._exit(0)
            print("Wi-Fi connection failed; restoring setup portal.", flush=True)
        except (OSError, subprocess.SubprocessError) as error:
            # Exception text can include the nmcli command and password.
            print(
                f"Wi-Fi connection interrupted ({type(error).__name__}); restoring setup portal.",
                flush=True,
            )
        try:
            restored = start_ap()
        except (OSError, subprocess.SubprocessError):
            restored = False
        if not restored:
            print("Could not restore setup portal; restarting service.", flush=True)
            os._exit(1)
    finally:
        connection_lock.release()


@app.route("/", methods=["GET", "POST"])
def index():
    last_network_name = ""
    error_message = None
    if request.method == "POST":
        network_name = request.form.get("ssid", "").strip()
        wifi_password = request.form.get("password", "")
        last_network_name = network_name
        if not network_name:
            error_message = "Escribe el nombre de la red."
        else:
            # Don't touch the radio yet — just render the confirmation page.
            # The AP stays up and Caddy stays down until the user clicks the
            # copy button on the next page, which posts to /commit.
            return render_template_string(
                SUCCESS,
                ssid=network_name,
                password=wifi_password,
                hostname=get_hostname(),
                ap_ssid=f"{get_hostname()}-setup",
            )
    return render_template_string(
        TEMPLATE,
        hostname=get_hostname(),
        ap_ssid=f"{get_hostname()}-setup",
        msg=error_message,
        last_ssid=last_network_name,
        ssids=scanned_ssids,
    )


@app.route("/commit", methods=["POST"])
def commit():
    """Actually trigger the Wi-Fi switch. Called by the copy button on the
    success page once the user has the POS URL on their clipboard."""
    network_name = request.form.get("ssid", "").strip()
    wifi_password = request.form.get("password", "")
    if not network_name:
        return "missing ssid", 400
    if not connection_lock.acquire(blocking=False):
        return "connection already in progress", 409
    try:
        threading.Thread(
            target=_connect_to_wifi,
            args=(network_name, wifi_password),
            daemon=True,
        ).start()
    except RuntimeError:
        connection_lock.release()
        app.logger.error("Could not start Wi-Fi connection worker")
        return "could not start connection", 503
    # Response body is rarely seen — the phone is about to lose the AP.
    return "ok", 200


